# Kotlin official code style (kotlin.code.style=official in gradle.properties),
# as ktlint's `ktlint_official` ruleset reads it. The IDE and any formatter the
# repository adopts later take their settings from here.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.{yml,yaml,toml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off
