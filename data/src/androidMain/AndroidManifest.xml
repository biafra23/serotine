<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The embedded Myotis light client (eth.serotine.data.engine): devp2p/libp2p peers,
         and the active network's DNS servers for its EIP-1459 peer discovery. Merged into
         the app's manifest. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The key store's biometric path (eth.serotine.data.keys.AndroidBiometricKey): whether
         the device offers strong biometrics, and the prompt that unlocks its key. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
</manifest>
