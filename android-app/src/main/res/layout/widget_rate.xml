<?xml version="1.0" encoding="utf-8"?>
<!-- The exchange-rate widget (RateWidget): the pair, the rate, its change over 24 hours, the
     button that refreshes it now and the line that dates it. The change has a view per direction, each with its colour from
     the resources, so the launcher picks the light or dark one itself; the widget shows one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_pair"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/rate_widget_placeholder_pair"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_change_up"
            style="@style/RateWidgetChange"
            android:textColor="@color/rate_up" />

        <TextView
            android:id="@+id/widget_change_down"
            style="@style/RateWidgetChange"
            android:textColor="@color/rate_down" />

        <TextView
            android:id="@+id/widget_change_flat"
            style="@style/RateWidgetChange"
            android:textColor="@color/widget_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_rate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/rate_widget_placeholder_rate"
            android:textColor="@color/widget_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Refresh now; while a refresh runs, the spinner stands in its place. -->
        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp">

            <ImageView
                android:id="@+id/widget_refresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_refresh_background"
                android:contentDescription="@string/rate_widget_refresh"
                android:padding="8dp"
                android:src="@drawable/ic_widget_refresh" />

            <ProgressBar
                android:id="@+id/widget_refreshing"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/rate_widget_refreshing"
                android:indeterminateTint="@color/widget_text_secondary"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp" />
</LinearLayout>
