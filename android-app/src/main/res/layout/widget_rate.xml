<?xml version="1.0" encoding="utf-8"?>
<!-- The exchange-rate widget (RateWidget): the pair, its change over 24 hours and the button
     that refreshes it now on the first line, the rate across the whole width under them, and the
     line that dates it. The change has a view per direction, each with its colour from the
     resources, so the launcher picks the light or dark one itself; the widget shows one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <!-- On a narrow widget the pair gives way first, then the change (ellipsized); the button
         never does: each is placed against the end, the button first. -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Refresh now, small beside the change; the spinner stands in its place while it runs. -->
        <FrameLayout
            android:id="@+id/widget_refresh_frame"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="6dp">

            <ImageView
                android:id="@+id/widget_refresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_refresh_background"
                android:contentDescription="@string/rate_widget_refresh"
                android:padding="4dp"
                android:src="@drawable/ic_widget_refresh" />

            <ProgressBar
                android:id="@+id/widget_refreshing"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:contentDescription="@string/rate_widget_refreshing"
                android:indeterminateTint="@color/widget_text_secondary"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/widget_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/widget_refresh_frame"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_change_up"
                style="@style/RateWidgetChange"
                android:textColor="@color/rate_up" />

            <TextView
                android:id="@+id/widget_change_down"
                style="@style/RateWidgetChange"
                android:textColor="@color/rate_down" />

            <TextView
                android:id="@+id/widget_change_flat"
                style="@style/RateWidgetChange"
                android:textColor="@color/widget_text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_pair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/widget_change"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/rate_widget_placeholder_pair"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp" />
    </RelativeLayout>

    <TextView
        android:id="@+id/widget_rate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/rate_widget_placeholder_rate"
        android:textColor="@color/widget_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp" />
</LinearLayout>
