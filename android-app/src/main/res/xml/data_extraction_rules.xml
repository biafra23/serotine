<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: nothing of the app's data leaves the device, neither to a cloud
     backup nor in a device-to-device transfer. allowBackup="false" alone still lets a
     device-to-device migration copy it (docs/keys-and-signing.md, rule 8). Today that is the
     account list (addresses and labels) and the engine's caches; the key store's files
     will be under the same exclusion. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
